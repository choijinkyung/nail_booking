# ─────────────────────────────────────────────────────────────
# Supabase (필수) — https://supabase.com 프로젝트 생성 후 Settings → API 에서 복사
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Settings → API → service_role (secret). 절대 클라이언트에 노출 금지, 서버에서만 사용.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────────────────────────────────────────────────────────
# 이메일 알림 (선택) — https://resend.com 에서 API Key 발급
# 값이 없으면 이메일 발송은 자동으로 건너뜁니다 (대시보드 알림은 계속 동작).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# 새 예약 요청 알림을 받을 관리자 이메일 (비우면 발송 안 함)
ADMIN_NOTIFICATION_EMAIL=""
# 발신 주소. Resend에서 도메인 인증 전에는 onboarding@resend.dev 사용 가능
EMAIL_FROM="Nail Booking <onboarding@resend.dev>"
